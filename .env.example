# IGNIS Environment Configuration Template
# Copy this file to backend/.env for local overrides

APP_ENV=development
DATABASE_URL=sqlite:///./ignis.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional LLM Integration (IGNIS runs in offline fallback mode by default without any keys)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
